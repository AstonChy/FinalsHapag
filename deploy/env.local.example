# ---- LOCAL (XAMPP / MySQL) .env values to change ----
APP_NAME=Hapag
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hapag
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

ADMIN_PASSWORD=choose-a-strong-password
RESTAURANT_NAME=Hapag

# Mailtrap (free) for testing email - get these from mailtrap.io > Email Testing > SMTP
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM_ADDRESS="reservations@hapag.test"
MAIL_FROM_NAME="${APP_NAME}"
