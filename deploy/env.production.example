# ---- INFINITYFREE: upload as htdocs/laravel/.env ----
APP_NAME=Hapag
APP_ENV=production
APP_KEY=PASTE_THE_APP_KEY_FROM_YOUR_LOCAL_.env
APP_DEBUG=false
APP_URL=https://yoursite.rf.gd

DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com        # from InfinityFree "MySQL Databases"
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_hapag
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=your_infinityfree_password

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single

ADMIN_PASSWORD=choose-a-strong-password
RESTAURANT_NAME=Hapag

# Same SMTP details you tested locally (see README note about free-host email limits)
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM_ADDRESS="reservations@yoursite.rf.gd"
MAIL_FROM_NAME="${APP_NAME}"
